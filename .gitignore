# ── SkillsCatalyst .gitignore ──────────────────────────────────────────────────

# Environment variables & secrets — NEVER commit these
.env
.env.*
!.env.example
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt
credentials.json
service_account*.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Next.js & Testing
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/

# Logs
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Supabase CLI temp files
supabase/.temp/
.temp/

# Scratch & local benchmark scripts
scratch/

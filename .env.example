# ── 2. WEB PUSH & VAPID (Production Browser Notifications) ───────────
# Public key shared with frontend client code
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BFsrNDthTDv7PBAW530ePvgD7OkIyp9np1f9m_cCr0WFBomDSAks5stl8981Yoax-wZh5xxEg6OsffRZ4ne8-Iw
# Private key strictly isolated to FastAPI backend server (NEVER commit/expose to frontend)
VAPID_PRIVATE_KEY=your-32-byte-base64url-private-key
# Contact URI for push services (mailto: or https:)
VAPID_SUBJECT=mailto:notifications@skillscatalyst.in
# Base application URL for notification links and action targets
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 3. PLATFORM CORE & ENVIRONMENT ──────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
SECRET_KEY=your-strong-production-secret-key-min-32-chars
OWNER_EMAIL=palamooradithyagoud@gmail.com
PORT=8000

# ── 4. AI & THIRD-PARTY SERVICES ────────────────────────────────────
GROQ_API_KEY=gsk_...
YOUTUBE_API_KEY=AIzaSy...
